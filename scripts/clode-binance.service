[Unit]
Description=Clode Binance Trading Bot
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=USER_PLACEHOLDER
WorkingDirectory=/opt/clode-binance
EnvironmentFile=/opt/clode-binance/.env
ExecStart=/opt/clode-binance/venv/bin/python main.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
