# Binance API
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Testnet (pune True pentru testare, False pentru real)
BINANCE_TESTNET=True

# Webhook secret — trebuie sa fie acelasi cu ce pui in TradingView alert
WEBHOOK_SECRET=alege_un_secret_puternic

# Server
HOST=0.0.0.0
PORT=8080

# Marimea ordinului in USDT (suma fixa per trade)
ORDER_SIZE_USDT=10.0

# Levier (pentru futures, lasa 1 pentru spot)
LEVERAGE=1

# Piata: SPOT sau FUTURES
MARKET_TYPE=SPOT

# Telegram notificari (optional)
TELEGRAM_BOT_TOKEN=token_bot_telegram
TELEGRAM_CHAT_ID=chat_id_al_tau
