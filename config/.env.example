# Exchange: mexc sau binance
EXCHANGE=mexc

# API Keys
API_KEY=cheia_ta_api
API_SECRET=secretul_tau_api

# Testnet (True doar daca exchange-ul are testnet)
TESTNET=False

# Webhook secret — acelasi cu ce pui in TradingView
WEBHOOK_SECRET=alege_un_secret_puternic

# Server
HOST=0.0.0.0
PORT=8080

# Marimea ordinului in USDT per trade (ignorat daca FIXED_QUANTITY > 0)
ORDER_SIZE_USDT=20.0

# Cantitate fixa per trade (0 = dezactivat, foloseste ORDER_SIZE_USDT)
FIXED_QUANTITY=0.0

# Levier (pentru futures)
LEVERAGE=1

# Piata: SPOT sau FUTURES
MARKET_TYPE=FUTURES

# Telegram notificari
TELEGRAM_BOT_TOKEN=token_bot_telegram
TELEGRAM_CHAT_ID=chat_id_al_tau
